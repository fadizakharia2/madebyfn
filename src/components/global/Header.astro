---
import type { Navigation, SiteSettings } from '@/lib/sanity/types';
import { resolveNavHref, routes } from '@/lib/routes';
import { hasImage } from '@/lib/sanity/image';
import SanityPicture from '@/components/ui/SanityPicture.astro';

interface Props {
  settings: SiteSettings;
  navigation: Navigation;
  currentPath: string;
}

const { settings, navigation, currentPath } = Astro.props;

const items = (navigation.mainItems ?? []).map((item) => {
  const href = resolveNavHref(item);
  const active = href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
  return { label: item.label ?? '', href, active, external: item.linkType === 'external', newTab: Boolean(item.openInNewTab) };
});

const cta = navigation.cta
  ? { label: navigation.cta.label ?? 'Start a Project', href: resolveNavHref(navigation.cta) }
  : { label: 'Start a Project', href: routes.start };

const availability = settings.availability;
const statusClass =
  availability?.status === 'limited' ? 'status__dot--busy' : availability?.status === 'unavailable' ? 'status__dot--closed' : '';
---

<header class="site-header" data-header>
  <a href={routes.home} class="wordmark" aria-label={`${settings.studioName} — home`}>
    {hasImage(settings.logo) ? (
      <span class="wordmark__logo"><SanityPicture image={settings.logo} widths={[120, 240]} sizes="120px" /></span>
    ) : (
      <span class="wordmark__name">{settings.studioName}</span>
    )}
    {settings.studioDescriptor && <span class="wordmark__descriptor">{settings.studioDescriptor}</span>}
  </a>

  <nav class="site-nav" aria-label="Primary">
    <ul class="site-nav__list">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['site-nav__link', { 'is-active': item.active }]}
            aria-current={item.active ? 'page' : undefined}
            target={item.newTab ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="site-header__right">
    {availability?.label && (
      <span class="status status--caps site-header__status">
        <span class:list={['status__dot status__dot--pulse', statusClass]} aria-hidden="true"></span>
        {availability.label}
      </span>
    )}
    <a href={cta.href} class="btn btn--primary btn--sm site-header__cta" data-cursor="Start" data-cursor-light="true">
      {cta.label}
    </a>
    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="menu-toggle__line" aria-hidden="true"></span>
      <span class="menu-toggle__line" aria-hidden="true"></span>
      <span class="menu-toggle__line" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden data-mobile-menu>
  <nav aria-label="Mobile">
    <ul class="mobile-menu__list">
      {items.map((item, i) => (
        <li class="mobile-menu__item" style={`--i:${i}`}>
          <a href={item.href} class="mobile-menu__link" aria-current={item.active ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
      <li class="mobile-menu__item mobile-menu__item--cta" style={`--i:${items.length}`}>
        <a href={cta.href} class="mobile-menu__link mobile-menu__link--accent">{cta.label}</a>
      </li>
    </ul>
  </nav>
  <div class="mobile-menu__footer">
    {availability?.label && (
      <span class="status status--caps">
        <span class:list={['status__dot', statusClass]} aria-hidden="true"></span>
        {availability.menuLabel || availability.label}
      </span>
    )}
    <a href={`mailto:${settings.primaryEmail}`} class="mobile-menu__email">{settings.primaryEmail}</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 22px var(--gutter);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      padding var(--dur-slow) var(--ease-out-expo),
      background var(--dur-slow) var(--ease-out-expo),
      border-color var(--dur-slow) var(--ease-out-expo);
  }
  .site-header.is-scrolled {
    padding-block: 14px;
    background: rgba(var(--bg-rgb) / 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border);
  }
  .site-header.is-menu-open {
    background: var(--color-bg);
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-shrink: 0;
  }
  .wordmark__name {
    font-family: var(--font-serif);
    font-size: 22px;
    letter-spacing: var(--tracking-heading);
    color: var(--color-fg);
    line-height: 1;
  }
  .wordmark__logo {
    display: block;
    height: 24px;
    width: auto;
  }
  .wordmark__logo :global(img) {
    height: 24px;
    width: auto;
    object-fit: contain;
    background: none;
  }
  .wordmark__descriptor {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-9);
  }
  .site-nav__link {
    position: relative;
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    letter-spacing: 0.01em;
    color: var(--color-muted);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .site-nav__link:hover {
    color: var(--color-fg-2);
  }
  .site-nav__link.is-active {
    color: var(--color-fg);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .site-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .site-header__status {
    color: var(--color-muted);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px 4px;
    margin: -8px -4px;
  }
  .menu-toggle__line {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--color-fg);
    transition: transform var(--dur-base) var(--ease-standard), opacity var(--dur-base) var(--ease-standard);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__line:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    padding: 100px 36px 60px;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__item {
    opacity: 0;
    animation: fade-up 0.5s var(--ease-standard) forwards;
    animation-delay: calc(var(--i) * 0.08s);
  }
  .mobile-menu__item--cta {
    margin-top: var(--space-5);
  }
  .mobile-menu__link {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(36px, 10vw, 68px);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    color: var(--color-fg);
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .mobile-menu__link--accent {
    color: var(--color-accent);
    border-bottom: 0;
  }
  .mobile-menu__footer {
    margin-top: auto;
    padding-top: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    opacity: 0;
    animation: fade-up 0.5s var(--ease-standard) 0.45s forwards;
  }
  .mobile-menu__email {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .site-header {
      padding-block: 18px;
    }
    .site-nav,
    .site-header__status,
    .site-header__cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }
  @media (min-width: 768px) {
    .mobile-menu {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__item,
    .mobile-menu__footer {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
    if (!header || !toggle || !menu) return;

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 50);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      header.classList.toggle('is-menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        menu.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:before-swap', () => {
    document.body.style.overflow = '';
  });
</script>
