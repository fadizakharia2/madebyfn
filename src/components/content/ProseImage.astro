---
import type { Props as NodeProps } from 'astro-portabletext/types';
import type { SanityImage } from '@/lib/sanity/types';
import SanityPicture from '@/components/ui/SanityPicture.astro';

type Props = NodeProps<SanityImage & { _type: 'imageWithAlt' }>;
const { node } = Astro.props;
---

<figure class="prose-image">
  <SanityPicture image={node} widths={[720, 1080, 1440]} sizes="(max-width: 767px) 100vw, 720px" />
  {node.caption && <figcaption>{node.caption}</figcaption>}
</figure>

<style>
  .prose-image :global(img) {
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    background: var(--color-bg-2);
  }
</style>
