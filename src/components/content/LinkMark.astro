---
import type { MarkProps } from 'astro-portabletext/types';

type Props = MarkProps<{ href?: string; openInNewTab?: boolean }>;
const { node } = Astro.props;
const href = node.markDef?.href ?? '#';
const external = Boolean(node.markDef?.openInNewTab) || /^https?:\/\//.test(href);
---

<a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><slot /></a>
