---
/** Brass-ruled aside used in articles and case studies. */
interface Props {
  node?: { tone?: string | null; heading?: string | null; body: string };
  callout?: { tone?: string | null; heading?: string | null; body: string };
}
const data = Astro.props.node ?? Astro.props.callout;
const tone = data?.tone ?? 'insight';
---

{data && (
  <aside class:list={['callout', `callout--${tone}`]}>
    {data.heading && <p class="callout__heading">{data.heading}</p>}
    <p class="callout__body">{data.body}</p>
  </aside>
)}

<style>
  .callout {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    margin-block: var(--space-10);
  }
  .callout--note {
    border-left-color: var(--color-accent-2);
  }
  .callout--warning {
    border-left-color: var(--color-warning);
  }
  .callout__heading {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }
  .callout--note .callout__heading { color: var(--color-accent-2); }
  .callout--warning .callout__heading { color: var(--color-warning); }
  .callout__body {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-fg);
  }
</style>
