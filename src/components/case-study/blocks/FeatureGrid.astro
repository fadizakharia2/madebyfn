---
import type { BlockFeatureGrid } from '@/lib/sanity/types';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { pad2 } from '@/lib/sanity/helpers';

interface Props {
  block: BlockFeatureGrid;
}
const { block } = Astro.props;
---

<section class="cs-section feature-grid">
  {(block.eyebrow || block.heading) && (
    <div class="gutter feature-grid__intro" data-reveal>
      <Eyebrow text={block.eyebrow} class="cs-eyebrow" />
      {block.heading && <h2 class="cs-display">{block.heading}</h2>}
    </div>
  )}
  <div class="gutter">
    <ul class="feature-grid__list">
      {block.features.map((f, i) => (
        <li class="feature" data-reveal data-reveal-delay={String(i % 3)}>
          <span class="feature__num">{pad2(i + 1)}</span>
          <h3 class="feature__title">{f.title}</h3>
          {f.body && <p class="feature__body">{f.body}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .feature-grid__intro {
    margin-bottom: var(--space-12);
  }
  .feature-grid__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .feature {
    background: var(--color-bg);
    padding: var(--space-10);
  }
  .feature__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
  .feature__title {
    font-family: var(--font-serif);
    font-size: var(--heading-2xs);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }
  .feature__body {
    font-size: var(--text-lg);
    color: var(--color-fg-2);
    line-height: 1.7;
  }
  @media (max-width: 1023px) {
    .feature-grid__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .feature-grid__list { grid-template-columns: 1fr; }
    .feature { padding: var(--space-6); }
  }
</style>
