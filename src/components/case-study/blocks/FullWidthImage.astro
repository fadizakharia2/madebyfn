---
import type { BlockFullWidthImage } from '@/lib/sanity/types';
import SanityPicture from '@/components/ui/SanityPicture.astro';

interface Props {
  block: BlockFullWidthImage;
}
const { block } = Astro.props;
const tall = block.height === 'tall';
---

<figure class:list={['fw-image', { 'fw-image--tall': tall }]}>
  <SanityPicture image={block.image} widths={[768, 1200, 1800, 2400]} sizes="100vw" filter="brightness(0.6) saturate(0.7)" />
  {block.image.caption && <figcaption class="fw-image__caption gutter">{block.image.caption}</figcaption>}
</figure>

<style>
  .fw-image {
    overflow: hidden;
    margin-block: 2px;
    background: var(--color-bg-2);
  }
  /* Full image at its own proportions. Very tall images are fitted to the
     viewport instead of running on for several screens. */
  .fw-image :global(img) {
    max-height: 90vh;
    object-fit: contain;
  }
  .fw-image--tall :global(img) {
    max-height: none;
  }
  .fw-image__caption {
    padding-block: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--color-muted);
  }
</style>
