---
import type { BlockComparison } from '@/lib/sanity/types';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  block: BlockComparison;
}
const { block } = Astro.props;
const before = block.beforeLabel || 'Before';
const after = block.afterLabel || 'After';
---

<section class="cs-section comparison gutter">
  <div class="comparison__intro" data-reveal>
    <Eyebrow text={block.eyebrow} class="cs-eyebrow" />
    {block.heading && <h2 class="cs-display">{block.heading}</h2>}
  </div>
  <table class="comparison__table" data-reveal>
    <thead>
      <tr>
        <th scope="col"><span class="visually-hidden">Aspect</span></th>
        <th scope="col">{before}</th>
        <th scope="col" class="comparison__after">{after}</th>
      </tr>
    </thead>
    <tbody>
      {block.rows.map((row) => (
        <tr>
          <th scope="row">{row.aspect}</th>
          <td data-label={before}>{row.before}</td>
          <td class="comparison__after" data-label={after}>{row.after}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .comparison__intro {
    margin-bottom: var(--space-12);
  }
  .comparison__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .comparison__table th,
  .comparison__table td {
    padding: var(--space-6) var(--space-8) var(--space-6) 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .comparison__table thead th {
    padding-top: 0;
    padding-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .comparison__table thead .comparison__after {
    color: var(--color-accent);
  }
  .comparison__table tbody th {
    width: 200px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .comparison__table td {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.6;
  }
  .comparison__table td.comparison__after {
    color: var(--color-fg-2);
  }
  @media (max-width: 767px) {
    .comparison__table thead { display: none; }
    .comparison__table tr { display: block; padding-block: var(--space-5); border-bottom: 1px solid var(--border); }
    .comparison__table th, .comparison__table td { display: block; border: 0; padding: 0; width: auto !important; }
    .comparison__table tbody th { margin-bottom: var(--space-3); }
    .comparison__table td { padding-left: var(--space-4) !important; margin-top: var(--space-2); border-left: 1px solid var(--border) !important; }
    .comparison__table td.comparison__after { border-left-color: var(--border-accent) !important; }
    .comparison__table td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 8px;
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 4px;
    }
    .comparison__table td.comparison__after::before { color: var(--color-accent); }
  }
</style>
