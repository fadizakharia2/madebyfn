---
import type { BlockRelatedProjects } from '@/lib/sanity/types';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';

interface Props {
  block: BlockRelatedProjects;
}
const { block } = Astro.props;
const projects = block.projects ?? [];
---

{projects.length > 0 && (
  <section class="cs-section cs-section--alt related">
    <div class="gutter related__intro" data-reveal>
      <Eyebrow text={block.heading || 'Related work'} class="cs-eyebrow" />
    </div>
    <div class="gutter">
      <ul class="related__grid" style={`--cols:${Math.min(projects.length, 3)}`}>
        {projects.map((p) => (
          <li class="related__item"><ProjectCard project={p} /></li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .related__intro {
    margin-bottom: var(--space-10);
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .related__item {
    background: var(--color-bg);
  }
  @media (max-width: 1023px) {
    .related__grid { grid-template-columns: 1fr; }
  }
</style>
