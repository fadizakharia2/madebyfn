---
import type { ArticleCard, Homepage } from '@/lib/sanity/types';
import { routes } from '@/lib/routes';
import { estimateReadingTime, formatDateShort } from '@/lib/sanity/helpers';
import SectionHeader from '@/components/ui/SectionHeader.astro';

/** Three editorial article previews. */
interface Props {
  section: NonNullable<Homepage['insights']>;
  articles: ArticleCard[];
}
const { section, articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="insights section section--bordered" id="insights">
    <SectionHeader eyebrow={section.eyebrow} heading={section.heading} linkLabel={section.linkLabel} linkHref={routes.insights} />
    <div class="gutter">
      <ul class="insights__grid">
        {articles.map((a, i) => (
          <li data-reveal data-reveal-delay={String(i)}>
            <a href={routes.article(a.slug)} class="insight" data-cursor="Read">
              <span class="insight__head">
                <span class="insight__cat">{a.category?.title}</span>
                <span class="insight__read">{a.readingTime ?? estimateReadingTime(a.body)} min read</span>
              </span>
              <h3 class="insight__title">{a.title}</h3>
              <span class="insight__date">{formatDateShort(a.publishedAt)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .insights__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border-top: 1px solid var(--border);
  }
  .insight {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-10) var(--space-9);
    background: var(--color-bg);
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .insight:hover {
    background: var(--color-bg-2);
  }
  .insight__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .insight__cat {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .insight__read,
  .insight__date {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
    letter-spacing: 0.06em;
  }
  .insight__title {
    font-family: var(--font-serif);
    font-size: var(--heading-2xs);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
    margin-bottom: var(--space-5);
    flex: 1;
  }
  .insight__date {
    letter-spacing: var(--tracking-label);
  }
  @media (max-width: 1023px) {
    .insights__grid { grid-template-columns: 1fr; }
    .insight { padding: var(--space-8) var(--space-6); }
  }
</style>
