---
import { hasImage, responsiveImage } from '@/lib/sanity/image';
import type { SanityImage } from '@/lib/sanity/types';

/**
 * Responsive <img> for Sanity images (or seed-marker images before import).
 *
 * Images are shown in full at their natural proportions. `aspect` forces a
 * crop and is reserved for places that need one (circular avatars).
 * `fit="contain"` fits the whole image inside a box sized by its parent,
 * for grids where cards must share one media height.
 */
interface Props {
  image: SanityImage | null | undefined;
  aspect?: number;
  fit?: 'natural' | 'contain' | 'cover';
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  filter?: string;
  alt?: string;
}

const {
  image,
  aspect,
  fit = aspect ? 'cover' : 'natural',
  widths,
  sizes = '100vw',
  priority = false,
  class: className = '',
  filter,
  alt,
} = Astro.props;

const resolved = hasImage(image) ? responsiveImage(image, { widths, aspect }) : null;
const style = [
  resolved && fit === 'cover' ? `object-position:${resolved.objectPosition}` : '',
  filter ? `filter:${filter}` : '',
]
  .filter(Boolean)
  .join(';');
---

{
  resolved ? (
    <img
      src={resolved.src}
      srcset={resolved.srcset}
      sizes={sizes}
      width={resolved.width}
      height={resolved.height}
      alt={alt ?? resolved.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      class:list={['sanity-picture', `sanity-picture--${fit}`, className]}
      style={style || undefined}
    />
  ) : (
    <div class:list={['sanity-picture sanity-picture--missing', className]} role="img" aria-label={alt ?? 'Image unavailable'}>
      <span class="mono">No image</span>
    </div>
  )
}

<style is:global>
  .sanity-picture {
    display: block;
    width: 100%;
    background: var(--color-surface);
  }
  /* Full image, natural proportions. */
  img.sanity-picture--natural {
    height: auto;
  }
  /* Whole image fitted inside a parent-sized box. */
  img.sanity-picture--contain {
    height: 100%;
    object-fit: contain;
    background: var(--color-bg-2);
  }
  /* Deliberate crop (avatars). */
  img.sanity-picture--cover {
    height: 100%;
    object-fit: cover;
  }
  .sanity-picture--missing {
    display: grid;
    place-items: center;
    background:
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--color-surface);
    color: var(--color-muted);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    min-height: 200px;
  }
</style>
