---
import { hasImage, responsiveImage } from '@/lib/sanity/image';
import type { SanityImage } from '@/lib/sanity/types';

/**
 * Responsive <img> for Sanity images (or seed-marker images before import).
 * Renders a neutral placeholder when no source is available so layouts hold.
 */
interface Props {
  image: SanityImage | null | undefined;
  aspect?: number;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  filter?: string;
  alt?: string;
}

const {
  image,
  aspect,
  widths,
  sizes = '100vw',
  priority = false,
  class: className = '',
  filter,
  alt,
} = Astro.props;

const resolved = hasImage(image) ? responsiveImage(image, { widths, aspect }) : null;
const style = [
  resolved ? `object-position:${resolved.objectPosition}` : '',
  filter ? `filter:${filter}` : '',
]
  .filter(Boolean)
  .join(';');
---

{
  resolved ? (
    <img
      src={resolved.src}
      srcset={resolved.srcset}
      sizes={sizes}
      width={resolved.width}
      height={resolved.height}
      alt={alt ?? resolved.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      class:list={['sanity-picture', className]}
      style={style || undefined}
    />
  ) : (
    <div class:list={['sanity-picture sanity-picture--missing', className]} role="img" aria-label={alt ?? 'Image unavailable'}>
      <span class="mono">No image</span>
    </div>
  )
}

<style>
  .sanity-picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--color-surface);
  }
  .sanity-picture--missing {
    display: grid;
    place-items: center;
    background:
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 40px 40px,
      var(--color-surface);
    color: var(--color-muted);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    min-height: 200px;
  }
</style>
