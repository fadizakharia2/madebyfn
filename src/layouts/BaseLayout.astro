---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/global/Header.astro';
import Footer from '@/components/global/Footer.astro';
import CustomCursor from '@/components/global/CustomCursor.astro';
import { getGlobals } from '@/lib/sanity/loaders';
import { organizationJsonLd, websiteJsonLd, type PageMeta } from '@/lib/seo';

/**
 * Page shell: fonts, SEO, global chrome, cursor, view transitions and the
 * scroll-reveal observer. Every route renders through this layout.
 */
interface Props {
  meta: PageMeta;
  jsonLd?: Array<Record<string, unknown>>;
  hideFooter?: boolean;
  bodyClass?: string;
}

const { meta, jsonLd = [], hideFooter = false, bodyClass } = Astro.props;
const { settings, navigation, developers } = await getGlobals();
const structuredData = [organizationJsonLd(settings), websiteJsonLd(settings), ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- ClientRouter swaps the <html> attributes on navigation, so re-add the class after each swap. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <Seo meta={meta} jsonLd={structuredData} favicon={settings.favicon} />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <ClientRouter />
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <CustomCursor />
    <Header settings={settings} navigation={navigation} currentPath={Astro.url.pathname} />
    <main id="main" class="site-main">
      <slot />
    </main>
    {!hideFooter && <Footer settings={settings} navigation={navigation} developers={developers} />}
  </body>
</html>

<style is:global>
  .site-main {
    padding-top: var(--header-h);
    min-height: 100dvh;
  }
</style>

<script>
  /**
   * Scroll reveal. Elements with [data-reveal] fade up once when they enter
   * the viewport. Re-run on every ClientRouter navigation.
   */
  function initReveal() {
    const items = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
    if (items.length === 0) return;

    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -5% 0px' },
    );

    items.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initReveal);
</script>
