---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PortableText from '@/components/content/PortableText.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { getGlobals, getLegalPageBySlug, getLegalPageSlugs } from '@/lib/sanity/loaders';
import { breadcrumbJsonLd, buildMeta } from '@/lib/seo';
import { routes } from '@/lib/routes';
import { formatDateLong } from '@/lib/sanity/helpers';

export async function getStaticPaths() {
  const slugs = await getLegalPageSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const [{ settings }, page] = await Promise.all([getGlobals(), getLegalPageBySlug(slug!)]);

if (!page) {
  return new Response(null, { status: 404 });
}

const meta = buildMeta({ settings, seo: page.seo, title: page.title, path: routes.legal(page.slug) });
const jsonLd = [breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: page.title, path: routes.legal(page.slug) }])];
---

<BaseLayout meta={meta} jsonLd={jsonLd}>
  <article class="legal gutter">
    <div class="legal__inner">
      <header class="legal__head">
        <Eyebrow text="Legal" class="legal__eyebrow" />
        <h1 class="legal__title">{page.title}</h1>
        {page.updatedAt && <p class="legal__updated">Last updated {formatDateLong(page.updatedAt)}</p>}
      </header>
      <PortableText value={page.body} />
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-20);
  }
  .legal__inner {
    max-width: var(--reading-width);
    margin-inline: auto;
  }
  .legal__head {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
  }
  .legal__eyebrow {
    margin-bottom: var(--space-5);
  }
  .legal__title {
    font-family: var(--font-serif);
    font-size: var(--display-sm);
    color: var(--color-fg);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  .legal__updated {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: var(--tracking-mono);
  }
</style>
