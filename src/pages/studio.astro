---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import SanityPicture from '@/components/ui/SanityPicture.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { getGlobals, getStudioPage } from '@/lib/sanity/loaders';
import { breadcrumbJsonLd, buildMeta, personJsonLd } from '@/lib/seo';
import { routes } from '@/lib/routes';
import { pad2 } from '@/lib/sanity/helpers';

const [{ settings }, page] = await Promise.all([getGlobals(), getStudioPage()]);
const developers = page.team?.developers ?? [];
const principles = page.principles?.items ?? [];
const meta = buildMeta({ settings, seo: page.seo, title: page.title ?? 'Studio', description: page.intro, path: routes.studio, image: developers[0]?.portrait });
const jsonLd = [
  breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: page.title ?? 'Studio', path: routes.studio }]),
  ...developers.map((d) => personJsonLd(d, settings)),
];
---

<BaseLayout meta={meta} jsonLd={jsonLd}>
  <PageHeader eyebrow={page.eyebrow} title={page.title} intro={page.intro} introWidth="600px" />

  {page.philosophy?.statement && (
    <section class="philosophy gutter section--alt" data-reveal>
      <Eyebrow text={page.philosophy.eyebrow || 'Philosophy'} class="philosophy__eyebrow" />
      <p class="philosophy__statement">{page.philosophy.statement}</p>
    </section>
  )}

  {principles.length > 0 && (
    <section class="principles gutter">
      <Eyebrow text={page.principles?.eyebrow || 'Principles'} class="principles__eyebrow" />
      <ol class="principles__grid">
        {principles.map((p, i) => (
          <li class="principle" data-reveal data-reveal-delay={String(i % 2)}>
            <span class="principle__num">{pad2(i + 1)}</span>
            <h2 class="principle__title">{p.title}</h2>
            <p class="principle__body">{p.body}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {developers.length > 0 && (
    <section class="team gutter section--alt">
      <Eyebrow text={page.team?.eyebrow || 'The Team'} class="team__eyebrow" />
      {developers.map((dev) => (
        <article class="member" id={dev.slug} data-reveal>
          <div class="member__portrait">
            <SanityPicture image={dev.alternatePortrait ?? dev.portrait} aspect={3 / 4} widths={[480, 720, 960]} sizes="(max-width: 767px) 100vw, 360px" filter="grayscale(20%) brightness(0.65)" />
            <div class="member__fade" aria-hidden="true"></div>
            {(dev.since || dev.yearsOfExperience) && (
              <span class="member__since">
                {dev.since && `Since ${dev.since}`}
                {dev.since && dev.yearsOfExperience ? ' · ' : ''}
                {dev.yearsOfExperience && `${dev.yearsOfExperience} years exp.`}
              </span>
            )}
          </div>
          <div class="member__info">
            <h2 class="member__name">{dev.name}</h2>
            <p class="member__role">{dev.title}</p>
            {(dev.longBio || dev.shortBio) && <p class="member__bio">{dev.longBio || dev.shortBio}</p>}
            {dev.approachQuote && (
              <blockquote class="member__quote"><p>“{dev.approachQuote}”</p></blockquote>
            )}
            {dev.skills && dev.skills.length > 0 && (
              <div class="member__skills">
                <p class="label member__label">{page.team?.specialitiesLabel || 'Specialities'}</p>
                <div class="tag-list">
                  {dev.skills.map((s) => <span class="tag tag--light tag--xs">{s}</span>)}
                </div>
              </div>
            )}
            {dev.featuredProjects && dev.featuredProjects.length > 0 && (
              <div class="member__projects">
                <p class="label member__label">Selected projects</p>
                <ul class="member__project-list">
                  {dev.featuredProjects.map((p) => (
                    <li><a href={p.slug ? routes.project(p.slug) : routes.work} class="member__project">{p.name} ↗</a></li>
                  ))}
                </ul>
              </div>
            )}
            <div class="member__links">
              {dev.github && <a href={dev.github} target="_blank" rel="noopener" class="member__link">GitHub ↗</a>}
              {dev.linkedin && <a href={dev.linkedin} target="_blank" rel="noopener" class="member__link">LinkedIn ↗</a>}
              {dev.website && <a href={dev.website} target="_blank" rel="noopener" class="member__link">Website ↗</a>}
              {dev.resumeUrl && <a href={dev.resumeUrl} target="_blank" rel="noopener" class="member__link">Résumé ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </section>
  )}

  <CtaBand heading={page.cta?.heading} buttonLabel={page.cta?.buttonLabel} href={routes.start} alt={false} bordered={false} />
</BaseLayout>

<style>
  .philosophy {
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--border);
  }
  .philosophy__eyebrow {
    margin-bottom: var(--space-10);
  }
  .philosophy__statement {
    font-family: var(--font-serif);
    font-size: var(--display-sm);
    color: var(--color-fg);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    max-width: 680px;
    text-wrap: pretty;
  }
  .principles {
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--border);
  }
  .principles__eyebrow {
    margin-bottom: var(--space-12);
  }
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .principle {
    background: var(--color-bg);
    padding: var(--space-10);
  }
  .principle__num {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
  .principle__title {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.5vw, 30px);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }
  .principle__body {
    font-size: var(--text-lg);
    color: var(--color-fg-2);
    line-height: 1.7;
  }
  .team {
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--border);
  }
  .team__eyebrow {
    margin-bottom: var(--space-16);
  }
  .member {
    display: grid;
    grid-template-columns: 360px 1fr;
    border-top: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));
  }
  .member + .member {
    margin-top: 2px;
  }
  .member__portrait {
    position: relative;
    height: 480px;
    overflow: hidden;
    border-right: 1px solid var(--border);
  }
  .member__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(var(--bg2-rgb) / 0.9) 0%, transparent 50%);
  }
  .member__since {
    position: absolute;
    bottom: 28px;
    left: 28px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .member__info {
    padding: var(--space-10) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .member__name {
    font-family: var(--font-serif);
    font-size: var(--heading-md);
    color: var(--color-fg);
    letter-spacing: var(--tracking-heading);
    margin-bottom: 8px;
  }
  .member__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: var(--space-7);
  }
  .member__bio {
    font-size: var(--text-lg);
    color: var(--color-fg-2);
    line-height: 1.75;
    margin-bottom: var(--space-6);
  }
  .member__quote {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-5);
    margin-bottom: var(--space-7);
  }
  .member__quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-fg);
    line-height: 1.6;
  }
  .member__label {
    margin-bottom: 10px;
  }
  .member__skills,
  .member__projects {
    margin-bottom: var(--space-5);
  }
  .member__project-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .member__project {
    font-size: var(--text-base);
    color: var(--color-fg-2);
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .member__project:hover {
    color: var(--color-accent);
  }
  .member__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .member__link {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-muted);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-mid);
    padding-bottom: 2px;
    transition: color var(--dur-fast) var(--ease-standard);
  }
  .member__link:hover {
    color: var(--color-accent);
  }
  @media (max-width: 1023px) {
    .member { grid-template-columns: 280px 1fr; }
    .member__portrait { height: 420px; }
  }
  @media (max-width: 767px) {
    .principles__grid { grid-template-columns: 1fr; }
    .principle { padding: var(--space-6); }
    .member { grid-template-columns: 1fr; }
    .member__portrait { height: 360px; border-right: 0; }
    .member__info { padding: var(--space-8) 0 var(--space-10); }
  }
</style>
