# ── Sanity ──────────────────────────────────────────────────────────────
# Public: safe to expose to the browser (used by the embedded Studio and
# the read-only content client).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-06-01

# Secret: only needed for `npm run sanity:seed` (write access) and for
# previewing draft content. Never prefix with PUBLIC_.
SANITY_API_TOKEN=

# Hosted Studio (npx sanity deploy). Same values as the PUBLIC_ ones; the
# Sanity CLI only reads SANITY_STUDIO_* variables. Hostname must be unique.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_HOSTNAME=madebyfn

# ── Resend ──────────────────────────────────────────────────────────────
# Secret API key from https://resend.com/api-keys
RESEND_API_KEY=
# Contacts are stored in a Resend segment (formerly "audience"). Paste the
# segment id from https://resend.com/segments. RESEND_AUDIENCE_ID is honoured
# as a legacy alias.
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
# Verified sender, e.g. "madebyfn <hello@madebyfn.com>". On the free tier
# without a verified domain use "onboarding@resend.dev".
RESEND_FROM_EMAIL=
# Inbox that receives project inquiries.
CONTACT_EMAIL=

# ── Site ────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://madebyfn.com
